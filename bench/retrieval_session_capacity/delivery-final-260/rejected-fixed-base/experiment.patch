+    pub fn experiment_fixed_base(&self, blob: &[u8], bits: usize) -> Result<KzgCommitment, KzgError> {
+        use blst::{blst_p1s_mult_wbits, blst_p1s_mult_wbits_precompute,
+            blst_p1s_mult_wbits_precompute_sizeof, blst_p1s_mult_wbits_scratch_sizeof};
+        if blob.len() != BLOB_SIZE || !(4..=6).contains(&bits) || self.g1_points_are_monomial || self.g1_points_blst.len() != SCALARS_PER_BLOB {
+            return Err(KzgError::InvalidDataLength);
+        }
+        for cell in blob.chunks_exact(32) { parse_scalar(cell)?; }
+        let mut saved = self.fixed_base_experiment.borrow_mut();
+        if saved.as_ref().is_none_or(|state| state.bits != bits) {
+            // Drop any previous experiment before allocating its replacement.
+            saved.take();
+            let n = SCALARS_PER_BLOB;
+            let table_bytes = unsafe { blst_p1s_mult_wbits_precompute_sizeof(bits, n) };
+            let scratch_bytes = unsafe { blst_p1s_mult_wbits_scratch_sizeof(n) };
+            let mut table = vec![blst_p1_affine::default(); table_bytes / std::mem::size_of::<blst_p1_affine>()];
+            let point_refs = [self.g1_points_blst.as_ptr(), std::ptr::null()];
+            unsafe { blst_p1s_mult_wbits_precompute(table.as_mut_ptr(), bits, point_refs.as_ptr(), n); }
+            *saved = Some(FixedBaseExperiment { bits, table,
+                scratch: vec![0; scratch_bytes / std::mem::size_of::<limb_t>()], scalars: vec![0; BLOB_SIZE] });
+        }
+        let state = saved.as_mut().unwrap();
+        reverse_blob_scalars_into(&mut state.scalars, blob, SCALARS_PER_BLOB);
+        let refs = [state.scalars.as_ptr(), std::ptr::null()];
+        let mut out = blst_p1::default();
+        unsafe { blst_p1s_mult_wbits(&mut out, state.table.as_ptr(), bits, SCALARS_PER_BLOB, refs.as_ptr(), 256, state.scratch.as_mut_ptr()); }
+        let mut commitment = [0; 48];
+        unsafe { blst_p1_compress(commitment.as_mut_ptr(), &out); }
+        Ok(commitment)
+    }
