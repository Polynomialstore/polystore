# Public read-only deployment qualification. Values are public and intentionally
# explicit so a reset cannot silently change chain or provider identity.
POLYSTORE_PUBLIC_RPC_BASE=https://rpc.polynomialstore.com
POLYSTORE_PUBLIC_LCD_BASE=https://lcd.polynomialstore.com
POLYSTORE_PUBLIC_EVM_BASE=https://evm.polynomialstore.com
POLYSTORE_PUBLIC_GATEWAY_BASE=https://gateway.polynomialstore.com
POLYSTORE_PUBLIC_FAUCET_BASE=https://faucet.polynomialstore.com
POLYSTORE_PUBLIC_BROWSER_ORIGIN=https://polynomialstore.com

POLYSTORE_EXPECTED_COSMOS_CHAIN_ID=20260211
POLYSTORE_EXPECTED_EVM_CHAIN_ID=20260211
POLYSTORE_EXPECTED_EIP712_CHAIN_ID=20260211
POLYSTORE_EXPECTED_EVM_DENOM=aatom
POLYSTORE_EXPECTED_CONSENSUS_MAX_GAS=64000000
POLYSTORE_EXPECTED_CONSENSUS_MAX_BYTES=2097152
POLYSTORE_EXPECTED_MIN_PROVIDER_BOND=150stake
POLYSTORE_PRECOMPILE_ADDRESS=0x0000000000000000000000000000000000000900

POLYSTORE_EXPECTED_PROVIDER_1="nil17d959aad6anxlhvnp2xcfnz409rx4h0yd3z4p0|https://sp1.polynomialstore.com|/dns4/sp1.polynomialstore.com/tcp/443/https"
POLYSTORE_EXPECTED_PROVIDER_2="nil17qj74xytdlanjz0j0tz2nge6qgh0pasfwetn7d|https://sp2.polynomialstore.com|/dns4/sp2.polynomialstore.com/tcp/443/https"
POLYSTORE_EXPECTED_PROVIDER_3="nil1dhr36atkrh9hmec8qpwdupnlqcjgusp03zn7uc|https://sp3.polynomialstore.com|/dns4/sp3.polynomialstore.com/tcp/443/https"

POLYSTORE_PUBLIC_BLOCK_WAIT=10
POLYSTORE_TLS_MIN_VALID_DAYS=14
